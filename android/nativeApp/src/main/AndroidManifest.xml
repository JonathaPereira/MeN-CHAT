<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application android:allowBackup="false" android:label="MenChat" android:icon="@mipmap/ic_launcher" android:theme="@style/Theme.MenChat" android:usesCleartextTraffic="false" android:supportsRtl="true">
        <activity android:name=".NativeActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <!-- Keep the old launcher component so pinned icons survive the update. This is an alias, not a browser Activity. -->
        <activity-alias android:name="com.google.androidbrowserhelper.trusted.LauncherActivity" android:targetActivity=".NativeActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
    </application>
</manifest>
