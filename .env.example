# Copie para .env.local e execute npm run supabase:check.
# Habilita a conexão das rotas reais /entrar, /primeiro-acesso e /conta.
# Exige base aplicada e conta provisionada; rotas antigas redirecionam para o app oficial.
# URL e chave PUBLICAVEL do projeto (nunca use service_role ou secret key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Convites automáticos: SOMENTE NO SERVIDOR. Nunca use NEXT_PUBLIC_ para esta chave.
SUPABASE_SECRET_KEY=
MENCHAT_SITE_URL=https://men-chat.vercel.app

# Notificações com o app fechado: gere com npm run push:keys.
# SOMENTE NO SERVIDOR; a API entrega apenas a chave pública ao usuário autenticado.
MENCHAT_VAPID_PUBLIC_KEY=
MENCHAT_VAPID_PRIVATE_KEY=
MENCHAT_VAPID_SUBJECT=https://men-chat.vercel.app
MENCHAT_PUSH_CRON_SECRET=

# Android 3: configuração PÚBLICA do app Firebase Android app.menchat.android.
# Estes quatro valores serão entregues pelo /api/mobile/config. NÃO use chave privada aqui.
MENCHAT_FIREBASE_APP_ID=
MENCHAT_FIREBASE_PROJECT_ID=
MENCHAT_FIREBASE_SENDER_ID=
MENCHAT_FIREBASE_API_KEY=

# FCM HTTP v1: conta de serviço, SOMENTE NO SERVIDOR/Vercel.
# A private_key aceita linhas reais ou os escapes \n do JSON. Nunca versione o JSON.
MENCHAT_FIREBASE_CLIENT_EMAIL=
MENCHAT_FIREBASE_PRIVATE_KEY=

# Chamadas: servidor TURN compatível com credenciais REST temporárias HMAC-SHA1.
# URLs em JSON; segredo compartilhado com o TURN SOMENTE NO SERVIDOR, mínimo 32 caracteres.
# Exemplo de formato: ["turn:turn.seu-dominio.com:3478?transport=udp","turns:turn.seu-dominio.com:5349?transport=tcp"]
MENCHAT_TURN_URLS=
MENCHAT_TURN_SECRET=
