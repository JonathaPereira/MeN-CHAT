# Copie para .env.local e execute npm run supabase:check.
# Habilita a conexão das rotas reais /entrar, /primeiro-acesso e /conta.
# Exige base aplicada e conta provisionada; rotas de demonstração continuam locais.
# URL e chave PUBLICAVEL do projeto (nunca use service_role ou secret key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Convites automáticos: SOMENTE NO SERVIDOR. Nunca use NEXT_PUBLIC_ para esta chave.
SUPABASE_SECRET_KEY=
MENCHAT_SITE_URL=https://men-chat.vercel.app

# Notificações com o app fechado: gere com npm run push:keys.
# SOMENTE NO SERVIDOR; a API entrega apenas a chave pública ao usuário autenticado.
MENCHAT_VAPID_PUBLIC_KEY=
MENCHAT_VAPID_PRIVATE_KEY=
MENCHAT_VAPID_SUBJECT=https://men-chat.vercel.app
MENCHAT_PUSH_CRON_SECRET=
